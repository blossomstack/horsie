/// Agent event types
package events;

use agent.AgentInput;
use agent.CompactionSkippedLifecycle;
use agent.CompactionTrigger;
use agent.Message;
use agent.Usage;
use agent.Role;

/// Input received by the agent — one per run() invocation
struct InputMessageEvent    { message_id: String, input: AgentInput }

/// Assistant message lifecycle
struct MessageStartEvent    { message_id: String, role: Role }
struct MessageStopEvent     { message_id: String }
struct MessageCompleteEvent { message_id: String, message: Message }

/// Streaming content blocks — emitted by the provider; index = content block
/// position. Every block follows the same lifecycle, keyed by index:
///   Start → Delta* → ContentBlockStop
/// Only the tool start carries identity (id+name); text/thinking starts are pure
/// boundary markers. ContentBlockStop is the one generic terminator for all kinds.
struct TextBlockStartEvent         { message_id: String, index: u32 }
struct TextChunkEvent              { message_id: String, index: u32, text: String }
struct ThinkingBlockStartEvent     { message_id: String, index: u32 }
struct ThinkingChunkEvent          { message_id: String, index: u32, text: String }
struct ThinkingSignatureChunkEvent { message_id: String, index: u32, signature: String }
struct ToolCallStartEvent          { message_id: String, index: u32, tool_call_id: String, name: String }
struct ToolCallInputDeltaEvent     { message_id: String, index: u32, tool_call_id: String, delta: String }
struct ContentBlockStopEvent       { message_id: String, index: u32 }

/// Tool execution — message_id is the tool-result message id ("result:<tool_call_id>")
struct ToolExecutingEvent { message_id: String, tool_call_id: String }
/// `at_ms` is the unix-epoch millisecond the tool finished. It rides on the
/// event so the tool-result message held in memory and the one folded from the
/// journal carry the identical stamp — read the clock twice and a replayed
/// transcript would disagree with the live one.
struct ToolCompleteEvent  { message_id: String, tool_call_id: String, output: String, is_error: bool, at_ms: u64 }

/// Run lifecycle — message_id is a UUID for this run invocation.
/// `usage` sums every provider call this run made (tool-loop iterations
/// included) — a cost figure, not a context-size one. `context_tokens` is the
/// *last* call's prompt size alone (provider-normalized to include any cache
/// tokens) — what's actually loaded in the model's context once the run ends.
/// `at_ms` is the unix-epoch millisecond the run finished.
struct RunCompleteEvent { message_id: String, usage: Usage, iterations: u32, context_tokens: u32, at_ms: u64 }

/// A run that ended badly — cancelled, or failed anywhere in the loop. The
/// tokens it spent were spent whatever became of it, so `usage` and
/// `context_tokens` mean exactly what they do on `RunCompleteEvent`. Both are
/// zero for a run cancelled before its first provider call answered.
///
/// Exactly one of `RunComplete` and `RunAborted` ends a run, never both, so a
/// reader may add either one's `usage` to a running total without
/// double-counting. A *turn* retried after a transient provider failure is
/// several runs and reports each — which is the truth, since each one called
/// the provider. Unlike `RunComplete` this says nothing about a turn, because
/// no turn completed.
struct RunAbortedEvent { message_id: String, usage: Usage, context_tokens: u32, at_ms: u64 }

/// Older history stopped being shown to the model. `message_id` is the run this
/// happened inside, or a fresh uuid for a `/compact` that ran on its own.
///
/// Emitted from the top of the tool loop, which is the only point in a run
/// where every `tool_use` already has its `tool_result` — a boundary taken
/// anywhere else could split a call from its answer.
///
/// Carries a message *id* rather than the `CompactionEntry`'s sequence numbers
/// because the two live in different numbering. A run holds a `Vec<Message>`
/// built by `prompt_messages`, which drops lifecycle entries and translates
/// hooks, so the nth message is not the nth log entry. The id is the one name
/// both sides share, and the fold — which is the only thing holding the log —
/// resolves it to a seq. Resolution is a search of an append-only log, so
/// replay reproduces it exactly.
struct CompactedEvent {
    message_id: String,
    summary: String,
    carried_state: String,
    /// Id of the first message still shown to the model raw. Absent when
    /// nothing was retained and the compaction is summary-only.
    retained_from_message_id: Option<String>,
    trigger: CompactionTrigger,
    instructions: Option<String>,
    tokens_before: u32,
    tokens_after: u32,
    at_ms: u64,
}

/// A compaction that was asked for and folded nothing. Carries the same
/// account the journaled lifecycle entry does, because it becomes one.
struct CompactionSkippedEvent {
    detail: CompactionSkippedLifecycle,
    at_ms: u64,
}

/// All events emitted during agent execution.
///
/// Flow per assistant turn:
///   InputMessage (once, at the start of run)
///   MessageStart → ( block )* → MessageStop → MessageComplete
///     where each block is one of:
///       TextBlockStart     → TextChunk*                              → ContentBlockStop
///       ThinkingBlockStart → (ThinkingChunk | ThinkingSignatureChunk)* → ContentBlockStop
///       ToolCallStart      → ToolCallInputDelta*                     → ContentBlockStop
///   ToolExecuting → ToolComplete  (one pair per tool call)
///   RunComplete   (or RunAborted, if the run ended in an error instead)
#[type_tag = "type"]
union AgentEvent {
    InputMessage(InputMessageEvent),
    MessageStart(MessageStartEvent),
    MessageStop(MessageStopEvent),
    MessageComplete(MessageCompleteEvent),
    TextBlockStart(TextBlockStartEvent),
    TextChunk(TextChunkEvent),
    ThinkingBlockStart(ThinkingBlockStartEvent),
    ThinkingChunk(ThinkingChunkEvent),
    ThinkingSignatureChunk(ThinkingSignatureChunkEvent),
    ToolCallStart(ToolCallStartEvent),
    ToolCallInputDelta(ToolCallInputDeltaEvent),
    ContentBlockStop(ContentBlockStopEvent),
    ToolExecuting(ToolExecutingEvent),
    ToolComplete(ToolCompleteEvent),
    RunComplete(RunCompleteEvent),
    RunAborted(RunAbortedEvent),
    Compacted(CompactedEvent),
    CompactionSkipped(CompactionSkippedEvent),
}
