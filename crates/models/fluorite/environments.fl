/// Where a session runs and what it runs against.
///
/// `EnvironmentSpec` is the answer every creation path takes — the sessions
/// API, an agent-preset invoke, a routine trigger, a workflow run — and none of
/// them defaults it. A predefined `EnvironmentView` is the reusable half of
/// that: a runtime vendor plus the repos, variables and setup steps to build it
/// with, saved under a name.
package environments;

use session_api.RepoConfig;
use executor.EnvVar;
use executor.ProvisionStep;

/// Where a session runs and what it runs against. Required by every path that
/// creates one: an optional environment would be a second, invisible way to
/// answer the question, settled by a server default nobody asked for.
#[type_tag = "type"]
union EnvironmentSpec {
    Runtime(RuntimeEnvironment),
    Named(NamedEnvironment),
    None(NoRuntime),
}

/// The ad-hoc environment: a runtime vendor, plus the repos to check out into
/// it when it can provision a workspace.
///
/// There is no separate variant for the local runtime. `vendor: "local"`
/// already says it, and a vendor that cannot provision rejects a non-empty
/// `repos` at create — a `Local` variant would be a second way to say the same
/// thing, with a vendor name baked into the protocol.
struct RuntimeEnvironment {
    vendor: String,
    repos: Option<Vec<RepoConfig>>,
}

/// A predefined environment, by name. Resolved and snapshotted when the session
/// is created, so editing or deleting it never re-points one that exists.
struct NamedEnvironment { name: String }

/// No runtime at all: the session runs with no sandbox, so it has no shell, no
/// files and no plugin skills — only the model, its MCP servers, its memory,
/// and the tools that delegate.
///
/// A variant rather than an absent field, for the same reason the union has no
/// default: "where does this run" is always answered, and "nowhere" is one of
/// the answers rather than the shape of a question nobody asked.
struct NoRuntime {}

/// A predefined environment as shown to clients.
struct EnvironmentView {
    /// Slug; the id of record, used in API paths.
    name: String,
    description: String,
    /// Runtime vendor name. Required, and never "local": environments only
    /// target vendor-managed, provisionable runtimes.
    vendor: String,
    /// Repositories cloned into the runtime workspace at provision time.
    repos: Vec<RepoConfig>,
    /// Plain-text, non-sensitive env vars for the runtime. Secrets are a
    /// future, separate concept. Names in the server's reserved `HORSIE_*`
    /// namespace are refused at save.
    env_vars: Vec<EnvVar>,
    /// Setup steps the runtime executes before its message loop, after the
    /// repo checkouts — a step like `make setup` needs its repo on disk.
    provision: Vec<ProvisionStep>,
    /// Unix epoch seconds.
    created_at: String,
    updated_at: String,
}

/// Create or fully replace an environment. Omitted list fields default to
/// empty; `description` defaults to "".
struct EnvironmentInput {
    name: String,
    description: Option<String>,
    vendor: String,
    repos: Option<Vec<RepoConfig>>,
    env_vars: Option<Vec<EnvVar>>,
    provision: Option<Vec<ProvisionStep>>,
}
