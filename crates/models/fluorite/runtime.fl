/// Protocol types for executor ↔ runtime communication
package runtime;

use hooks.HookRecord;

// --- Tool inputs ---

// Paths are absolute, or relative to the caller's working directory — its
// `set_working_dir` override if it has one, else the first workspace. There is
// no workspace argument: an absolute path is how a call reaches another
// workspace or the shared plugin library.
struct BashInput { command: String, timeout_secs: Option<u64> }
struct ReadFileInput { path: String, start_line: Option<u64>, end_line: Option<u64> }
struct WriteFileInput { path: String, content: String }

// Content-based find/replace. `regex` (default false) switches `find` from a
// literal string to a pattern; `replace_all` (default false) requires the match
// to be unique and errors otherwise — set it true to change every occurrence.
struct FindAndReplaceInput { path: String, find: String, replace: String, regex: Option<bool>, replace_all: Option<bool> }

// Positional replacement: swap the 1-based, inclusive line range for `replacement`.
struct ReplaceLinesInput { path: String, start_line: u64, end_line: u64, replacement: String }

struct ListFilesInput { path: String }
struct GlobInput { pattern: String, path: Option<String>, max_results: Option<u64> }
struct GrepInput { pattern: String, path: Option<String>, file_pattern: Option<String>, max_results: Option<u64> }

// Set the caller's working directory for all future tool calls. `path` may be
// absolute or relative to the current effective cwd; omit it to reset to the
// default working directory (the first workspace).
struct SetWorkingDirInput { path: Option<String> }

// Set (`value` present) or unset (`value` absent) an env var for the caller's
// future bash commands. Keyed by ToolCallRequest.agent_id like the cwd
// override, so agents sharing one runtime stay isolated.
struct SetEnvInput { name: String, value: Option<String> }

/// One variant per tool. The tag doubles as the tool name seen by the LLM.
#[type_tag = "tool"]
union ToolCall {
    Bash(BashInput),
    ReadFile(ReadFileInput),
    WriteFile(WriteFileInput),
    FindAndReplace(FindAndReplaceInput),
    ReplaceLines(ReplaceLinesInput),
    ListFiles(ListFilesInput),
    Glob(GlobInput),
    Grep(GrepInput),
    SetWorkingDir(SetWorkingDirInput),
    SetEnv(SetEnvInput),
}

// --- Workspace scan ---

// Parameterized so the runtime stays convention-agnostic: the client supplies the
// instruction filenames to try (in order) and the skills glob. Raw contents come
// back; the client parses frontmatter.
struct ScanRequest {
    call_id: String,
    workspace: Option<String>,
    instruction_candidates: Vec<String>,
    skills_glob: String,
    /// When true, also enumerate the shared plugin library and return its skills in
    /// `ScanResponse.shared_skills`. The client sets this only for opted-in agents.
    include_shared: bool,
}

struct ScannedFile { path: String, content: String }
struct WorkspaceScan {
    name: String,
    path: String,
    is_git_repo: bool,
    instructions: Option<ScannedFile>,
    skills: Vec<ScannedFile>,
    /// Runtime OS/arch (`<os>-<arch>`, e.g. "macos-aarch64"); optional so an
    /// older runtime binary still deserializes against a newer server.
    platform: Option<String>,
}

/// A skill discovered in the shared plugin library. `rel_dir` is the skill's
/// directory relative to the plugins root, which arrives as
/// `ScanResponse.shared_root`; joining the two gives the absolute directory the
/// agent needs to read sibling resources with the filesystem tools.
struct PluginSkill {
    plugin: String,
    rel_dir: String,
    content: String,
}

/// An agent definition discovered in the shared plugin library: one `*.md` with
/// frontmatter naming it, and a body that is its system prompt. `rel_path` is
/// relative to the plugins root, so it identifies the file without depending on
/// where the library happens to be mounted.
///
/// The bytes travel and the *server* parses them, exactly as skills do: the
/// runtime is the only process that can see plugin files, and reading
/// frontmatter is not file access.
struct PluginAgent {
    plugin: String,
    rel_path: String,
    content: String,
}
struct ScanResponse {
    call_id: String,
    workspaces: Vec<WorkspaceScan>,
    shared_skills: Vec<PluginSkill>,
    /// Agent definitions from the same library. Optional so an older runtime
    /// binary still deserializes against a newer server.
    shared_agents: Option<Vec<PluginAgent>>,
    /// Absolute path of the shared plugin library root, when one is configured
    /// and the request asked for it. Optional so an older runtime binary still
    /// deserializes against a newer server.
    shared_root: Option<String>,
}

// --- Plugin MCP servers ---

/// One tool a plugin-declared MCP server offers. `name` is already namespaced
/// `mcp__<server>__<tool>`, the spelling admin-configured servers use — so
/// `allowed_tools` and hook matchers see one vocabulary whichever path a tool
/// came from.
struct PluginMcpTool {
    name: String,
    description: Option<String>,
    /// JSON Schema, verbatim from the server.
    input_schema: String,
}

/// Connect to every MCP server the loaded plugins declare and list their tools.
///
/// One request rather than one per server: a session wants the whole tool list
/// or none of it, and a server that cannot start contributes nothing rather than
/// failing the scan.
struct McpDiscoverRequest  { call_id: String }
struct McpDiscoverResponse {
    call_id: String,
    tools: Vec<PluginMcpTool>,
    /// Servers that contributed no tools. Reported rather than dropped, so a
    /// broken declaration is visible without being fatal.
    failures: Vec<McpServerFailure>,
}

/// It could not be reached at all: no such binary, a refused connection, a
/// declaration that would not parse.
struct McpServerUnreachable { server: String, reason: String }

/// It answered `401`. `resource_metadata` is the RFC 9728 URL its
/// `WWW-Authenticate` named, when it named one.
struct McpServerNeedsAuth { server: String, resource_metadata: Option<String> }

/// Why a declared server contributed no tools this pass. Typed rather than a
/// string because the two cases call for different answers: one is a broken
/// plugin to report, the other is a consent flow to offer.
#[type_tag = "failure"]
union McpServerFailure {
    Unreachable(McpServerUnreachable),
    NeedsAuth(McpServerNeedsAuth),
}

/// Call one tool on a plugin-declared MCP server. `tool` is the namespaced name
/// from discovery; the runtime splits it back into server and tool.
struct McpInvokeRequest  { call_id: String, tool: String, arguments: String }
struct McpInvokeResponse { call_id: String, result: ToolResult }

// --- Server-initiated hooks ---

/// How the session that is starting came to start.
///
/// The spec's whole vocabulary, not the subset horsie produces. `Clear`,
/// `Compact` and `Fork` have no call site — horsie has no fork and no clear,
/// and although it does compact, it deliberately does not re-fire
/// `SessionStart` afterwards: `PostCompact` already covers reacting to one, and
/// re-running every session-start hook for something that is not a session
/// start would be a second, worse way to say the same thing. They are arms
/// nothing constructs rather than values that silently never appear, which is
/// the same honesty `is_wired()` gives an event horsie cannot fire. A matcher
/// on one of them selects nothing.
#[type_tag = "source"]
union SessionStartSource {
    Startup,
    Resume,
    Clear,
    Compact,
    Fork,
}

struct SessionStartInput { source: SessionStartSource }
/// A subagent starting. `agent_id` names *which* subagent; `agent_type` is the
/// matcher domain, the way `source` is for `SessionStart`. Both, because until
/// #105's Phase 2 gives horsie an agent-type concept every subagent reports the
/// same type, and the id is then the only thing telling two apart.
struct SubagentStartInput { agent_id: String, agent_type: String }
struct UserPromptSubmitInput { prompt: String }
/// An invocation about to be expanded. `command` is the matcher domain — the
/// name, so a hook can guard `/deploy` rather than every prompt — and `kind`
/// says which of `command`, `skill` or `agent` it named.
struct UserPromptExpansionInput { prompt: String, command: String, kind: String }
/// `stop_hook_active` is true when horsie is only still running because a
/// previous `Stop` hook blocked. A cooperative hook returns early rather than
/// looping; the server's hard cap exists for the hooks that do not.
struct StopInput { last_assistant_message: Option<String>, stop_hook_active: bool }
/// A subagent's turn ending. Carries the same pair `SubagentStart` does, so a
/// hook can join its own start to its own stop.
struct SubagentStopInput {
    agent_id: String,
    agent_type: String,
    last_assistant_message: Option<String>,
    stop_hook_active: bool,
}

/// A compaction about to happen. `trigger` is the matcher domain — `auto` or
/// `manual` — so a hook can guard the automatic case without also firing on
/// every `/compact` someone types. `instructions` is what `/compact` was given.
///
/// Fired before any history is rewritten, which is what makes it the last
/// chance to write something down that the summary would otherwise be the only
/// record of. A hook that blocks abandons the compaction.
struct PreCompactInput { trigger: String, instructions: Option<String> }

/// A compaction that happened. Same matcher domain as `PreCompact`; the token
/// counts are what it bought.
struct PostCompactInput { trigger: String, tokens_before: u32, tokens_after: u32 }

/// An event the server initiates, carrying that event's input.
///
/// Tool events are absent by construction: they run inline in the runtime with
/// the call they guard, so asking for one out of band is unrepresentable rather
/// than merely wrong. Only wired events have arms — promoting one of the ten
/// described-but-unwired events adds its arm here alongside its call site.
#[type_tag = "event"]
union ServerHookEvent {
    SessionStart(SessionStartInput),
    SubagentStart(SubagentStartInput),
    UserPromptSubmit(UserPromptSubmitInput),
    UserPromptExpansion(UserPromptExpansionInput),
    Stop(StopInput),
    SubagentStop(SubagentStopInput),
    PreCompact(PreCompactInput),
    PostCompact(PostCompactInput),
}

/// Run every matching hook for one server-initiated event inside the sandbox.
struct RunHooksRequest  { call_id: String, event: ServerHookEvent }
/// Every hook that ran, in execution order. Injected context is derived from
/// these rather than carried beside them, so no event is recorded specially.
struct RunHooksResponse { call_id: String, records: Vec<HookRecord> }

// --- Inbound (executor → runtime) ---

// agent_id keys the runtime's per-agent cwd/env state — one bucket per calling
// agent, so an agent and its subagents, or sessions sharing a runtime, cannot
// see each other's cwd or env.
//
// Required rather than optional: an unkeyed call would silently share mutable
// state with every other unkeyed caller, which is the exact failure this field
// exists to prevent. Today it is the session id, which is also the main agent's
// journal id (`agent/<session-uuid>`); a subagent stamps its own.
struct ToolCallRequest  { call_id: String, agent_id: String, call: ToolCall }
struct CancelCallRequest { call_id: String }

/// Asks the runtime what it is currently executing.
///
/// A liveness call, and the only request in this protocol with a bound the
/// caller may act on: it is answered concurrently, never queued behind a running
/// tool, so an unanswered one says something a slow tool never could.
struct PingRequest { call_id: String }

#[type_tag = "type"]
union RuntimeInboundMessage {
    ToolCall(ToolCallRequest),
    CancelCall(CancelCallRequest),
    ScanWorkspace(ScanRequest),
    RunHooks(RunHooksRequest),
    McpDiscover(McpDiscoverRequest),
    McpInvoke(McpInvokeRequest),
    Ping(PingRequest),
}

// --- Outbound (runtime → executor) ---

struct ToolOutput { stdout: String, stderr: String, exit_code: i32 }
struct ToolError  { reason: String }

#[type_tag = "status"]
union ToolResult { Ok(ToolOutput), Err(ToolError) }

struct ToolCallResponse {
    call_id: String,
    result: ToolResult,
    /// Every hook that ran for this call, in execution order. Empty for the
    /// overwhelmingly common case of a session with no matching hooks.
    hooks: Vec<HookRecord>,
}

/// First message the runtime sends after connecting.
struct RuntimeReady { runtime_id: String }

/// Announces that the runtime is executing provision steps before Ready. The
/// executor extends its handshake deadline and expects Ready or
/// ProvisionFailed next on this connection.
struct RuntimeProvisioning { runtime_id: String }

/// Provision steps failed; the runtime exits after sending this. `message` is
/// surfaced as the create/attach failure reason.
struct RuntimeProvisionFailed { runtime_id: String, message: String }

/// Every request this runtime is currently executing, by call id.
///
/// The load-bearing part is `in_flight`, not the reply itself: it turns liveness
/// from a boolean into a reconciliation against the caller's own list, which is
/// what lets a twenty-minute build be told apart from a request the runtime never
/// heard of. A boolean answer cannot distinguish them, and any deadline that
/// tried would have to bound the one thing here with no natural bound.
struct PongResponse { call_id: String, in_flight: Vec<String> }

/// All messages the runtime sends to the executor.
#[type_tag = "type"]
union RuntimeOutboundMessage {
    Ready(RuntimeReady),
    Provisioning(RuntimeProvisioning),
    ProvisionFailed(RuntimeProvisionFailed),
    ToolCallResponse(ToolCallResponse),
    ScanResult(ScanResponse),
    HookRecords(RunHooksResponse),
    McpTools(McpDiscoverResponse),
    McpResult(McpInvokeResponse),
    Pong(PongResponse),
}
