/// Wire types for the session server: session views and the messages stream.
package session;

use agent.Message;
use agent.AgentLogEntry;
use agent.Usage;
// `task_list` is the agent's own tool state, so `TaskItem` lives with the agent
// and is imported back here rather than defined here. Also required by the
// dependency direction: `agent.fl` carries the log entry that reports a task
// list, and `agent` cannot import from `session` while `session` imports agent.
use agent.TaskItem;
use agent.TaskStatus;

/// User-visible lifecycle state of a session. Failure reasons ride separately
/// in `last_error` so the enum stays a plain discriminant.
enum SessionStatusKind {
    /// The runtime is being built. A session is created in this state and
    /// leaves it once its vendor confirms the runtime; anything sent
    /// meanwhile is queued and runs as soon as it does.
    Provisioning,
    Idle,
    Running,
    AwaitingInput,
    Failed,
    Unrecoverable,
}

/// One key-value annotation on a session. Annotations ride as a vec of
/// entries (fluorite has no map type); keys are unique per session.
struct AnnotationEntry {
    key: String,
    value: String,
}

/// Agent settings supplied at session creation.
struct AgentSettings {
    model: String,
    allowed_tools: Option<Vec<String>>,
    use_plugins: Option<bool>,
    max_iterations: Option<u32>,
    max_retries: Option<u32>,
    /// Names of enabled MCP servers this session may call, namespaced
    /// `mcp__<name>__<tool>`; absent → none.
    mcp_servers: Option<Vec<String>>,
    /// Memory spaces this session may read and write; absent → none, and the
    /// memory_* tools are not offered.
    memory_spaces: Option<Vec<String>>,
    /// Canonical thinking effort for this session, chosen from the model's
    /// offered list. Absent → the model's configured default.
    thinking_effort: Option<String>,
    /// Cap on concurrently-active subagents in this session; absent → the
    /// server's built-in default (8).
    max_concurrent_subagents: Option<u32>,
    /// Standing instructions this session's agent runs under, added to the
    /// system prompt as its own section. Set from an agent preset, or directly
    /// here; absent → none.
    instructions: Option<String>,
}

struct SessionSummary {
    id: String,
    name: Option<String>,
    /// Absent when the session is not loaded: the server does not guess, and
    /// a restart leaves every row unknown until one is opened.
    status: Option<SessionStatusKind>,
    created_at: u64,
    last_error: Option<String>,
    /// The workflow this session is a run of. Present only for a run, which is
    /// what lets the session list annotate one without a second request.
    /// Routine runs carry nothing here — they are not in the list at all.
    workflow: Option<String>,
    /// User-set key-value metadata (e.g. `group=<name>`). Empty when none.
    annotations: Vec<AnnotationEntry>,
}

/// Answers to every question one agent is parked on, delivered together
struct AnswerAsksRequest {
    answers: Vec<AskAnswerInput>,
}

struct AskAnswerInput {
    tool_call_id: String,
    text: String,
}

struct SessionDetail {
    id: String,
    name: Option<String>,
    status: Option<SessionStatusKind>,
    created_at: u64,
    last_error: Option<String>,
    /// User-set key-value metadata (e.g. `group=<name>`). Empty when none.
    annotations: Vec<AnnotationEntry>,
    model: String,
    /// The predefined environment this session was created from; absent when it
    /// was created from an ad-hoc runtime. `vendor` and `repos` are what it
    /// resolved to, and stay the answer to what the session actually got.
    environment: Option<String>,
    vendor: String,
    /// Clone URLs of the session's provisioned repos (empty when none).
    repos: Vec<String>,
    /// Selected skill-bundle names (empty when none).
    plugins: Vec<String>,
    /// Enabled MCP server names (empty when none).
    mcp_servers: Vec<String>,
    /// Selected memory space names (empty when none).
    memory_spaces: Vec<String>,
    /// Whether the runtime's plugin/skill machinery is enabled for this session.
    use_plugins: bool,
    /// The session's frozen thinking effort, chosen at creation or inherited
    /// from the model's default. Absent → the model exposes no thinking
    /// control.
    thinking_effort: Option<String>,
    /// Token usage summed across every agent this session hosts. Per-agent
    /// numbers (and context size, which is never summed) are on the agent
    /// document instead.
    usage_total: UsageView,
    /// Every agent this session hosts: the main agent first, then its subagent
    /// tree. Each is addressable at `/sessions/:id/agents/:agent_id`.
    agents: Vec<SubAgentView>,
    /// The resource-preparation stage a turn is currently at, when one is
    /// spinning up. Live-only history: past stages are not replayable.
    progression: Option<ProgressionEvent>,
    /// The workflow this session is a run of, if it is one. Decides which view
    /// the page renders: a run has a graph rather than a conversation.
    workflow: Option<String>,
}

/// One agent this session hosts. The main agent has `parent`/`label` absent
/// and `depth` 0; subagents carry their spawn metadata. `output` and the full
/// transcript live on the agent document and its history, not here.
struct SubAgentView {
    id: String,
    /// Parent agent id; absent → the session's main agent.
    parent: Option<String>,
    label: Option<String>,
    depth: u32,
    /// The plugin-declared agent type this subagent runs as, when it was
    /// spawned with one. Absent for the main agent and for a general-purpose
    /// subagent.
    agent_type: Option<String>,
    /// "running" | "completed" | "failed".
    status: String,
    error: Option<String>,
    /// When this agent was spawned and when it reached its current result.
    /// Zero when unrecorded — journaled before these were kept, or (for
    /// `ended_at_ms`) still running.
    spawned_at_ms: u64,
    ended_at_ms: u64,
}

// --- The messages stream ---

/// One frame on `GET /sessions/:id/messages`.
///
/// Two arms because there are two kinds of thing to carry, and they differ in
/// exactly one respect that matters: an `Entry` is durable and replayable, a
/// `Delta` is neither. A tagged union rather than "whichever field is present"
/// so a client's match is exhaustive and a third arm cannot be added silently.
#[type_tag = "type"]
union MessageFrame {
    Window(MessageWindow),
    Entry(AgentLogEntry),
    Delta(MessageDelta),
}

/// The first frame of a replay, describing the window that follows.
///
/// A cursorless connect replays at most a capped number of the newest entries,
/// so a long-running session does not resend its whole history on every open.
/// `has_more_before` says whether the cap actually bit — the client cannot
/// infer it from the first entry's `seq`, because a log front-trimmed for
/// context management has no seq 0 either, and the two cases want opposite
/// behaviour. Sent only when there is no cursor: a resuming client already
/// knows where it is.
struct MessageWindow {
    /// Older entries exist before this window; page back with `before=` to get
    /// them.
    has_more_before: bool,
    /// The seq of the oldest entry in this window, which is the cursor to page
    /// back from. Absent when the window is empty.
    earliest_seq: Option<u64>,
}

/// A chunk of the message being written.
///
/// Carries the entry it follows, because a chunk means nothing without one.
/// `delta_seq` restarts at 1 after every entry, which is what makes a stale
/// position detectable: a client claiming more chunks than this run has emitted
/// was talking to a run that has since restarted, and `reset` says so.
struct MessageDelta {
    entry_seq: u64,
    delta_seq: u32,
    text: String,
    /// Discard the partial text you hold: these chunks start a new run.
    reset: bool,
}

/// A resource-preparation progression — shown live while a turn spins up and
/// kept for audit. `stage` is a stable key (`acquiring_runtime`,
/// `scanning_workspace`, `connecting_tools`, `ready`); `detail` is optional
/// human text; `at_ms` is the unix-epoch millisecond it occurred.
struct ProgressionEvent { stage: String, detail: Option<String>, at_ms: u64 }

/// Cumulative token usage across a session's completed turns. `u64` (not the
/// per-turn `Usage`'s `u32`) because it sums re-sent context over many turns.
/// Cache fields are `Option<u64>`, absent only when no completed turn ever
/// reported cache data — never coerced to a fake zero.
struct UsageView {
    input_tokens: u64,
    output_tokens: u64,
    cache_creation_tokens: Option<u64>,
    cache_read_tokens: Option<u64>,
}

/// A status frame on the global `/api/events` stream.
struct GlobalSessionStatusEvent {
    session_id: String,
    status: SessionStatusKind,
    reason: Option<String>,
}

/// A title frame on the global `/api/events` stream.
struct GlobalSessionTitleEvent {
    session_id: String,
    name: String,
}

/// One frame on the global `/api/events` stream (live session-list updates).
#[type_tag = "type"]
union GlobalSessionEvent {
    StatusChanged(GlobalSessionStatusEvent),
    TitleChanged(GlobalSessionTitleEvent),
}
