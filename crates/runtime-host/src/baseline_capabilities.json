{
  "network": { "type": "Allow", "value": {} },
  "grants": [
    { "type": "Dir", "value": { "path": "/", "access": "Read" } },
    { "type": "WorkingDir", "value": { "access": "ReadWrite" } },
    { "type": "TempDir", "value": { "access": "ReadWrite" } },
    { "type": "Dir", "value": { "path": "/tmp", "access": "ReadWrite" } },
    { "type": "File", "value": { "path": "/dev/null", "access": "ReadWrite" } },
    { "type": "File", "value": { "path": "/dev/zero", "access": "Read" } },
    { "type": "File", "value": { "path": "/dev/urandom", "access": "Read" } },
    { "type": "File", "value": { "path": "/dev/random", "access": "Read" } },
    { "type": "File", "value": { "path": "/dev/tty", "access": "ReadWrite" } }
  ],
  "unsafeSeatbeltRules": [
    "(allow mach-lookup (global-name \"com.apple.SecurityServer\"))",
    "(deny mach-lookup (global-name \"com.apple.securityd\"))",
    "(deny mach-lookup (global-name \"com.apple.security.keychaind\"))",
    "(deny mach-lookup (global-name \"com.apple.secd\"))",
    "(deny mach-lookup (global-name \"com.apple.security.agent\"))"
  ]
}
