/// Protocol types for server <-> runtime-vendor communication.
///
/// A runtime vendor is an external process that owns runtime lifecycle: it
/// spawns or schedules runtimes, listens for their dial-back, and relays the
/// runtime protocol between them and the server over this one link.
///
/// Naming follows `runtime.fl`: inbound/outbound are named from the *vendor's*
/// point of view (a vendor receives commands and sends events), correlated
/// operations come in `XxxRequest`/`XxxResponse` pairs, and unsolicited
/// announcements get plain names.
///
/// Everything that is not lifecycle is relayed verbatim rather than
/// re-modelled — see `RuntimeRelayRequest`. The vendor does not understand
/// tool calls, and should not have to.
package runtime_vendor;

use capabilities.CapabilitySpec;
use executor.EnvVar;
use executor.ProvisionStep;
use executor.RuntimeInfo;
use executor.RuntimeState;
use runtime.RuntimeInboundMessage;
use runtime.RuntimeOutboundMessage;

// --- Payloads ───────────────────────────────────────────────────────────────

/// What a vendor can do with a session workspace, announced by the vendor
/// itself so the server and UI never branch on vendor name or kind.
struct RuntimeVendorCapabilities {
    /// The vendor provisions a fresh workspace it owns — cloning repos,
    /// installing skill bundles, running provision steps. A vendor fixed to a
    /// user-owned directory announces false.
    supports_provisioning: bool,
}

/// Everything the server can supply about a runtime. Deliberately minimal:
/// anything the vendor knows better (workspace paths, plugin unpack dirs,
/// artifact base URLs) is resolved vendor-side and never crosses the wire.
struct RuntimeSpec {
    /// Workspace *names*. The vendor resolves each to a path it owns, and
    /// fails the request if it cannot honor one.
    workspaces: Vec<String>,
    /// Resolved secrets and handles only the server can mint: the scoped
    /// GitHub token, the plugin bundle manifest, the plugins token.
    env: Vec<EnvVar>,
    /// Setup steps the runtime executes before its message loop.
    provision: Vec<ProvisionStep>,
    /// Sandbox policy, inline rather than as a server-local file path. The
    /// vendor writes it to its own disk and passes --sandbox-caps.
    sandbox_capabilities: Option<CapabilitySpec>,
}

// --- Requests (server -> vendor) ────────────────────────────────────────────

struct CreateRuntimeRequest { runtime_id: String, spec: RuntimeSpec }

/// Revive a preserved runtime. Vendors that cannot resume in place provision a
/// fresh instance against the same spec.
struct AttachRuntimeRequest { runtime_id: String, spec: RuntimeSpec }

/// Halt without destroying — the runtime stays re-attachable.
struct StopRuntimeRequest { runtime_id: String }

/// The owning session was deleted; the vendor decides the runtime's fate.
struct DeleteRuntimeRequest { runtime_id: String }

/// Asked on reconnect so the server can reconcile what survived.
struct QueryRuntimesRequest {}

/// The runtime protocol, addressed to one of this vendor's runtimes and
/// forwarded verbatim. Tool calls, cancels, workspace scans, and session-start
/// hooks all travel this way, so adding a runtime capability needs no change
/// here at all.
///
/// A relayed `CancelCall` draws no response, exactly as in `runtime.fl`.
struct RuntimeRelayRequest { runtime_id: String, message: RuntimeInboundMessage }

#[type_tag = "type"]
union RuntimeVendorCommand {
    CreateRuntime(CreateRuntimeRequest),
    AttachRuntime(AttachRuntimeRequest),
    StopRuntime(StopRuntimeRequest),
    DeleteRuntime(DeleteRuntimeRequest),
    QueryRuntimes(QueryRuntimesRequest),
    Runtime(RuntimeRelayRequest),
}

struct RuntimeVendorInboundMessage { request_id: String, command: RuntimeVendorCommand }

// --- Responses (vendor -> server, correlated by request_id) ─────────────────

struct CreateRuntimeResponse { runtime_id: String }
struct AttachRuntimeResponse { runtime_id: String }
struct StopRuntimeResponse { runtime_id: String }
struct DeleteRuntimeResponse { runtime_id: String }
struct QueryRuntimesResponse { runtimes: Vec<RuntimeInfo> }

/// A runtime's own reply, forwarded verbatim.
///
/// The union permits `Ready`/`Provisioning`/`ProvisionFailed` because it wraps
/// `RuntimeOutboundMessage` whole, but those never cross this link in practice:
/// they arrive during a runtime's dial-back handshake, before any request has
/// been relayed, and the vendor consumes them itself.
struct RuntimeRelayResponse { runtime_id: String, message: RuntimeOutboundMessage }

/// The failure reply to any request. Carries no runtime id — the `request_id`
/// on the envelope already identifies what failed.
struct RequestFailed { message: String }

// --- Announcements (vendor -> server, unsolicited) ──────────────────────────

/// First message a vendor sends, mirroring `RuntimeReady`. `vendor_name` is
/// the name sessions select by.
struct RuntimeVendorReady { vendor_name: String, capabilities: RuntimeVendorCapabilities }

/// A runtime changed state on its own — it died, or finished stopping.
///
/// Distinct from the lifecycle responses above, which answer something the
/// server asked for. This one arrives unbidden, and is the server's only
/// warning that a runtime is gone while its vendor is still connected.
struct RuntimeStateChanged { runtime_id: String, state: RuntimeState }

#[type_tag = "type"]
union RuntimeVendorEvent {
    Ready(RuntimeVendorReady),
    CreateRuntime(CreateRuntimeResponse),
    AttachRuntime(AttachRuntimeResponse),
    StopRuntime(StopRuntimeResponse),
    DeleteRuntime(DeleteRuntimeResponse),
    QueryRuntimes(QueryRuntimesResponse),
    Runtime(RuntimeRelayResponse),
    RequestFailed(RequestFailed),
    RuntimeStateChanged(RuntimeStateChanged),
}

/// request_id echoes the request's for responses; a fresh UUID for
/// unsolicited announcements (`Ready`, `RuntimeStateChanged`).
struct RuntimeVendorOutboundMessage { request_id: String, event: RuntimeVendorEvent }
