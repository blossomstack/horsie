/// Wire types for the server settings API: a redacted view of the
/// runtime-editable configuration, and the update inputs that replace it.
/// Secrets are never returned — provider/vendor views carry only a boolean
/// flag for a stored inline secret.
package settings;

/// One configured LLM provider, redacted for display.
struct ProviderView {
    /// Provider name — the key a model's `provider` references.
    name: String,
    /// Provider kind: "anthropic" or "openai".
    kind: String,
    base_url: Option<String>,
    /// True when an inline `api_key` is stored.
    has_inline_key: bool,
    /// Retain thinking-block signatures from this provider. Required for
    /// genuine Anthropic (it validates them on replay); off for
    /// Anthropic-compatible endpoints, which do not.
    keep_thinking_signature: bool,
}

/// One configured model alias.
struct ModelView {
    /// The alias sessions select (e.g. "sonnet").
    alias: String,
    /// Name of the provider this model routes to.
    provider: String,
    /// The provider's model identifier (e.g. "claude-sonnet-4-6").
    model_id: String,
    max_tokens: Option<u32>,
    /// The model's total context window, in tokens. A built-in default is
    /// applied for known model ids when a model is added with this omitted.
    context_window: Option<u32>,
    /// Canonical thinking-effort values this model offers, in ascending order.
    /// Absent → the model exposes no thinking control.
    thinking_efforts: Option<Vec<String>>,
    /// Default applied when a session does not choose one.
    thinking_effort: Option<String>,
    /// Wire encoding for this model's thinking control.
    thinking_dialect: Option<String>,
}

/// What a vendor can do with a session workspace. Announced by the vendor
/// itself; the new-session UI reads it to decide what to prompt for, instead
/// of branching on the vendor's name or kind.
struct VendorCapabilities {
    /// The vendor provisions a workspace it owns — cloning repos, installing
    /// skill bundles, running provision steps. A vendor that runs in a fixed,
    /// user-owned directory (the shared local daemon) provisions nothing.
    supports_provisioning: bool,
}

/// A runtime vendor sessions can target.
///
/// Every vendor is a connected agent now: the server holds no vendor
/// configuration and builds nothing, so this is a live roster rather than a
/// settings record. A vendor appears once its agent completes the handshake
/// and disappears when the link drops — there is no configured-but-inactive
/// state, so no config block and no build error to report.
struct VendorView {
    /// The name the agent announced, which sessions select by.
    name: String,
    /// Whether new sessions default to this vendor.
    is_default: bool,
    /// What the agent announced it can do with a session workspace.
    capabilities: VendorCapabilities,
}

/// Read-only deployment paths and version, for transparency. `config_path` is
/// the deployment config file (config.json); `database` is where the editable
/// settings above are stored — the two never overlap.
struct ServerInfo {
    config_path: String,
    database: String,
    state_dir: String,
    data_dir: String,
    plugins_dir: String,
    version: String,
}

/// Full settings snapshot — returned by `GET /api/config` and after an update.
struct SettingsView {
    providers: Vec<ProviderView>,
    models: Vec<ModelView>,
    vendors: Vec<VendorView>,
    default_vendor: String,
    info: ServerInfo,
    /// Always false: every provider/model edit applies live. Retained for wire
    /// compatibility.
    restart_required: bool,
}

// --- update inputs ---

/// A provider to persist. Replaces any provider of the same `name`.
struct ProviderInput {
    name: String,
    /// Provider kind: "anthropic" or "openai".
    kind: String,
    base_url: Option<String>,
    /// New inline key. Omit to keep the existing stored key; "" to clear.
    api_key: Option<String>,
    /// Retain thinking-block signatures from this provider. Omit for the
    /// default (off) — required for genuine Anthropic, which validates them.
    keep_thinking_signature: Option<bool>,
}

/// A model alias to persist.
struct ModelInput {
    alias: String,
    provider: String,
    model_id: String,
    max_tokens: Option<u32>,
    context_window: Option<u32>,
    thinking_efforts: Option<Vec<String>>,
    thinking_effort: Option<String>,
    thinking_dialect: Option<String>,
}

/// Replace the runtime-editable settings. Each present field fully replaces
/// that section; an omitted (null) field leaves it unchanged. Vendors are
/// absent by design: they are connected agents, configured in their own
/// processes, so there is nothing here to persist.
struct SettingsUpdate {
    providers: Option<Vec<ProviderInput>>,
    models: Option<Vec<ModelInput>>,
    default_vendor: Option<String>,
}
