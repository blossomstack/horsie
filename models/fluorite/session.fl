/// Wire types for the session server: session views and the SSE event union.
package session;

use agent.Message;
use agent.Usage;

/// User-visible lifecycle state of a session. Failure reasons ride separately
/// in `last_error` so the enum stays a plain discriminant.
enum SessionStatusKind {
    Idle,
    Running,
    AwaitingInput,
    Failed,
    Unrecoverable,
}

/// Agent settings supplied at session creation.
struct AgentSettings {
    model: String,
    allowed_tools: Option<Vec<String>>,
    use_plugins: Option<bool>,
    max_iterations: Option<u32>,
    max_retries: Option<u32>,
    /// Names of enabled MCP servers this session may call, namespaced
    /// `mcp__<name>__<tool>`; absent → none.
    mcp_servers: Option<Vec<String>>,
    /// Memory spaces this session may read and write; absent → none, and the
    /// memory_* tools are not offered.
    memory_spaces: Option<Vec<String>>,
    /// Canonical thinking effort for this session, chosen from the model's
    /// offered list. Absent → the model's configured default.
    thinking_effort: Option<String>,
    /// Cap on concurrently-active subagents in this session; absent → the
    /// server's built-in default (8).
    max_concurrent_subagents: Option<u32>,
}

struct SessionSummary {
    id: String,
    name: Option<String>,
    /// Absent when the session is not loaded: the server does not guess, and
    /// a restart leaves every row unknown until one is opened.
    status: Option<SessionStatusKind>,
    created_at: u64,
    last_error: Option<String>,
}

/// A user message the server has accepted but not yet answered. It rides on
/// the detail endpoint and on `InboxChanged` so a client can render it as
/// still-unanswered rather than as part of the transcript.
struct QueuedMessage {
    id: String,
    text: String,
    at_ms: u64,
}

/// One question the agent is parked on. `tool_call_id` is what an answer is
/// addressed to; it is absent only for a question journaled before call ids
/// were recorded, which can be read but not answered
struct PendingAskView {
    tool_call_id: Option<String>,
    question: String,
}

/// Answers to every pending ask of a session, delivered together
struct AnswerAsksRequest {
    answers: Vec<AskAnswerInput>,
}

struct AskAnswerInput {
    tool_call_id: String,
    text: String,
}

struct SessionDetail {
    id: String,
    name: Option<String>,
    status: Option<SessionStatusKind>,
    created_at: u64,
    last_error: Option<String>,
    /// The first question the agent is awaiting an answer to (status
    /// AwaitingInput). Kept for clients that show a single question.
    pending_question: Option<String>,
    /// Every question the agent is awaiting an answer to, oldest first. All of
    /// them must be answered in one request before the turn can resume.
    pending_asks: Vec<PendingAskView>,
    model: String,
    vendor: String,
    /// Clone URLs of the session's provisioned repos (empty when none).
    repos: Vec<String>,
    /// Selected skill-bundle names (empty when none).
    plugins: Vec<String>,
    /// Enabled MCP server names (empty when none).
    mcp_servers: Vec<String>,
    /// Selected memory space names (empty when none).
    memory_spaces: Vec<String>,
    /// Whether the runtime's plugin/skill machinery is enabled for this session.
    use_plugins: bool,
    /// The session's frozen thinking effort, chosen at creation or inherited
    /// from the model's default. Absent → the model exposes no thinking
    /// control.
    thinking_effort: Option<String>,
    /// Messages accepted but not yet carried into a turn, oldest first (empty
    /// when nothing is owed).
    inbox: Vec<QueuedMessage>,
}

// --- SSE event payloads ---

/// A complete transcript message (user, assistant, or tool result), replayed
/// from the durable journal. Carries an SSE id (the journal sequence number).
struct MessageEvent { message: Message }
struct ToolOutputEvent { tool_call_id: String, output: String, is_error: bool }
struct TurnCompletedEvent { iterations: u32, usage: Usage }
/// The queue as it stands now, sent whole on every change — never a delta.
/// Emitted when a message is accepted and again when a turn carries messages
/// out of the queue, so a second tab needs no reload to stay honest.
struct InboxChangedEvent { queued: Vec<QueuedMessage> }
/// Live status transition. Sent without an SSE id (the session detail endpoint
/// is the durable source for status).
/// `pending_asks` rides along so a client learns what to answer the moment the
/// agent parks, without refetching the session
struct StatusChangedEvent {
    status: SessionStatusKind,
    reason: Option<String>,
    pending_asks: Vec<PendingAskView>,
}
struct ErrorEvent { message: String }
/// Streaming text delta — live only, never journaled, never carries an SSE id.
struct DeltaEvent { text: String }
struct ToolStartEvent { tool_call_id: String, name: String }
/// A resource-preparation progression — shown live while a turn spins up and
/// kept for audit. `stage` is a stable key (`provisioning_runtime`,
/// `scanning_workspace`, `connecting_tools`, `ready`); `detail` is optional
/// human text; `at_ms` is the unix-epoch millisecond it occurred.
struct ProgressionEvent { stage: String, detail: Option<String>, at_ms: u64 }

/// Status of one entry in the agent's `task_list` tool state.
enum TaskStatus {
    Pending,
    InProgress,
    Completed,
}

/// One entry in the agent's `task_list` tool state.
struct TaskItem {
    id: u32,
    content: String,
    status: TaskStatus,
}

/// The agent's `task_list` tool state, sent whole on every mutation
/// (create/insert/update_status) — never a delta.
struct TaskListEvent { tasks: Vec<TaskItem> }

/// Cumulative token usage across a session's completed turns. `u64` (not the
/// per-turn `Usage`'s `u32`) because it sums re-sent context over many turns.
/// Cache fields are `Option<u64>`, absent only when no completed turn ever
/// reported cache data — never coerced to a fake zero.
struct UsageView {
    input_tokens: u64,
    output_tokens: u64,
    cache_creation_tokens: Option<u64>,
    cache_read_tokens: Option<u64>,
}

/// One agent's own usage plus its context-size snapshot, labeled with the
/// model it ran. `context_window`, unlike everything else here, is not agent
/// state — it's attached by the HTTP layer from the model's configured value.
struct AgentUsageView {
    model: String,
    usage_total: UsageView,
    /// The most recently completed run's own usage — a per-run cost figure.
    /// Absent before this agent's first completed run.
    last_turn_usage: Option<Usage>,
    /// The most recently completed run's last provider call's prompt size
    /// alone — what's actually loaded in this agent's context right now.
    context_tokens: u32,
    /// The model's configured context window, when known.
    context_window: Option<u32>,
}

/// A session's aggregated usage. `session_total` sums every agent this
/// session hosts (today, just the one); context-size state is never summed
/// across agents — see `main_agent` for that, kept per-agent on purpose.
struct SessionUsageStats {
    session_total: UsageView,
    main_agent: AgentUsageView,
}

#[type_tag = "type"]
union SessionEvent {
    Message(MessageEvent),
    ToolResult(ToolOutputEvent),
    TurnCompleted(TurnCompletedEvent),
    InboxChanged(InboxChangedEvent),
    StatusChanged(StatusChangedEvent),
    Error(ErrorEvent),
    Delta(DeltaEvent),
    ToolStart(ToolStartEvent),
    TaskListChanged(TaskListEvent),
    Progressed(ProgressionEvent),
}

/// A status frame on the global `/api/events` stream.
struct GlobalSessionStatusEvent {
    session_id: String,
    status: SessionStatusKind,
    reason: Option<String>,
}

/// A title frame on the global `/api/events` stream.
struct GlobalSessionTitleEvent {
    session_id: String,
    name: String,
}

/// One frame on the global `/api/events` stream (live session-list updates).
#[type_tag = "type"]
union GlobalSessionEvent {
    StatusChanged(GlobalSessionStatusEvent),
    TitleChanged(GlobalSessionTitleEvent),
}
